<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_OrderFulfillment"
                  targetNamespace="http://example.com/bpmn/order-fulfillment">
  <bpmn:process id="Process_OrderFulfillment" name="Order Fulfillment" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderPlaced" name="Order Placed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Fork" name="Split">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2a</bpmn:outgoing>
      <bpmn:outgoing>Flow_2b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_InventoryCheck" name="Inventory Check">
      <bpmn:incoming>Flow_2a</bpmn:incoming>
      <bpmn:outgoing>Flow_3a</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PaymentVerification" name="Payment Verification">
      <bpmn:incoming>Flow_2b</bpmn:incoming>
      <bpmn:outgoing>Flow_3b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Join" name="Join">
      <bpmn:incoming>Flow_3a</bpmn:incoming>
      <bpmn:incoming>Flow_3b</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ReadyToShip" name="Ready to Ship">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Shipped" name="Shipped">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Delivered" name="Delivered">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_OrderPlaced" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_2a" sourceRef="Gateway_Fork" targetRef="Task_InventoryCheck" />
    <bpmn:sequenceFlow id="Flow_2b" sourceRef="Gateway_Fork" targetRef="Task_PaymentVerification" />
    <bpmn:sequenceFlow id="Flow_3a" sourceRef="Task_InventoryCheck" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_3b" sourceRef="Task_PaymentVerification" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Join" targetRef="Task_ReadyToShip" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReadyToShip" targetRef="Task_Shipped" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Shipped" targetRef="EndEvent_Delivered" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_OrderFulfillment">
      <bpmndi:BPMNShape id="StartEvent_OrderPlaced_di" bpmnElement="StartEvent_OrderPlaced">
        <dc:Bounds x="160" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_di" bpmnElement="Gateway_Fork">
        <dc:Bounds x="250" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InventoryCheck_di" bpmnElement="Task_InventoryCheck">
        <dc:Bounds x="360" y="100" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PaymentVerification_di" bpmnElement="Task_PaymentVerification">
        <dc:Bounds x="360" y="260" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join">
        <dc:Bounds x="530" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReadyToShip_di" bpmnElement="Task_ReadyToShip">
        <dc:Bounds x="630" y="178" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Shipped_di" bpmnElement="Task_Shipped">
        <dc:Bounds x="790" y="178" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Delivered_di" bpmnElement="EndEvent_Delivered">
        <dc:Bounds x="950" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="218" />
        <di:waypoint x="250" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2a_di" bpmnElement="Flow_2a">
        <di:waypoint x="275" y="193" />
        <di:waypoint x="275" y="140" />
        <di:waypoint x="360" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2b_di" bpmnElement="Flow_2b">
        <di:waypoint x="275" y="243" />
        <di:waypoint x="275" y="300" />
        <di:waypoint x="360" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3a_di" bpmnElement="Flow_3a">
        <di:waypoint x="470" y="140" />
        <di:waypoint x="555" y="140" />
        <di:waypoint x="555" y="193" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3b_di" bpmnElement="Flow_3b">
        <di:waypoint x="470" y="300" />
        <di:waypoint x="555" y="300" />
        <di:waypoint x="555" y="243" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="580" y="218" />
        <di:waypoint x="630" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="740" y="218" />
        <di:waypoint x="790" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="900" y="218" />
        <di:waypoint x="950" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
